  "id": "craftmaster",
  "version": "${version}",
  "name": "CraftMaster",
  "description": "L'event CraftMaster : saisons de tâches, scores, classement, busts, chaises et rideaux de scène.",
  "authors": ["LordFinn"],
  "license": "All Rights Reserved",
  "icon": "assets/craftmaster/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["fr.lordfinn.craftmaster.CraftMaster"],
    "client": ["fr.lordfinn.craftmaster.client.CraftMasterClient"]
  },
  "mixins": ["craftmaster.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*"
  }
}
